# Copie para .env SOMENTE no seu computador. Nunca envie .env ao Git ou ao chat.
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=https://ppzlnrydbdxdkbytrwly.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
# Gere SESSION_SECRET com node scripts/generate-secret.mjs e guarde nas configurações seguras.
# Cadastro fica bloqueado até cumprir os pré-requisitos e confirmar o backup externo.
PUBLIC_AUTH_ENABLED=false
EMAIL_SETUP_CONFIRMED=false
BACKUP_SETUP_CONFIRMED=false
TURNSTILE_SITE_KEY=
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=
# Backups: gere OUTRA chave com o mesmo gerador. Ela não é a SESSION_SECRET.
BACKUP_ENCRYPTION_KEY=
# Opcionais, somente no servidor. O consumo Netlify refere-se à equipe.
DATABASE_LIMIT_MB=
NETLIFY_API_TOKEN=
NETLIFY_ACCOUNT_SLUG=
NETLIFY_DASHBOARD_URL=https://app.netlify.com/projects/peaceful-genie-fd5166
